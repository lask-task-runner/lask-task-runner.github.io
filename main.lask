// The documentation site, previewed with nothing installed but Lask and
// Docker: Node and VitePress run in a container, and the pages are
// generated from a lask checkout mounted into it.
//
//   lask sync          # one-time: pulls the Node image
//   lask run dev       # http://localhost:5173, reloads as you edit
//   lask run preview   # every version as CI builds it, http://localhost:4173

// The full Debian image, not -slim: scripts/sync.mjs lists the lask
// checkout's tracked files with git, which -slim does not carry.
node_image = #node:24.21.0-bookworm

// node_modules lives in a Docker volume, not in the project directory:
// esbuild and Rollup install native binaries for the platform they run
// on, so a node_modules from macOS does not load in Linux, nor the reverse.
modules_volume = "lask-docs-node-modules:/work/node_modules"

quiet: Map<String> = {
  "npm_config_update_notifier": "false",
  "npm_config_fund": "false",
  "npm_config_audit": "false"
}

node = runnable(node_image, env = quiet, volumes = [modules_volume])

command { "node", "npm", "npx" } on node

// The same image with a lask checkout mounted read-only at /lask, where
// scripts/sync.mjs reads it, and the given ports published to the host.
// The mount is not always passed file-change events, so the dev server
// polls instead.
internal site(lask_src: String, publish: Array<String>): Runnable = runnable(node_image,
  env = merge(quiet, {"LASK_SRC": "/lask", "CHOKIDAR_USEPOLLING": "1"}),
  volumes = [modules_volume, "#{lask_src}:/lask:ro"],
  publish = publish
)

// Docker mounts absolute paths only.
internal absolute(path: String): String = case {
  is_absolute_path(path) -> path
  else -> normalize_path(path_join([get_env("PWD"), path]))
}

internal default_lask_src(): String = get_env_or("LASK_SRC", "../lask")

internal default_tools_src(): String = get_env_or("TOOLS_SRC", "../lask-module-tools")

// Dump lask's help for the official module at the ref each version in
// versions.json names, into .module-help/, for the module reference.
// It runs on the host: it needs the lask binary, which the Node container
// does not have.
internal module_help(tools_src: String) = do {
  listed: Record<versions: Array<Map<String>>> = cast(from_json(read_file("versions.json", #local)))
  for (v : listed.versions) {
    ref = get_or(v, "tools", "")
    case {
      ref == "" -> "no module reference for #{v["version"]}"
      else -> $[#local] sh scripts/module-help.sh #{shell_quote(tools_src)} #{shell_quote(ref)} #{shell_quote(".module-help/tools-#{ref}")}
    }
  }
}

// Install the dependencies exactly as package-lock.json pins them, into
// the node_modules volume. Run it again after package.json changes.
install() = $ npm ci

internal ensure_installed() = $[node] test -x node_modules/.bin/vitepress || npm ci

// Generate the pages from the lask checkout into docs/, without building.
//
// @param lask_src  The lask checkout: ../lask unless LASK_SRC names another.
// @example lask run pages --lask-src ~/src/lask
pages(--lask_src: String = default_lask_src()) = do {
  ensure_installed()
  $[site(absolute(lask_src), [])] npm run sync
}

// The dev server with hot reload, until you stop it.
//
// The pages are generated once, at start: after changing the lask
// checkout, restart it or run `lask run pages` beside it.
//
// @param port      The port, on the host and in the container alike.
// @param lask_src  The lask checkout: ../lask unless LASK_SRC names another.
// @param tools_src The lask-module-tools checkout, for the module reference:
//                  ../lask-module-tools unless TOOLS_SRC names another.
// @example lask run dev --port 8080
dev(--port: Number = 5173, --lask_src: String = default_lask_src(), --tools_src: String = default_tools_src()) = do {
  ensure_installed()
  module_help(tools_src)
  log("open http://localhost:#{port}")
  $[site(absolute(lask_src), ["127.0.0.1:#{port}:#{port}"])] npm run dev -- --host 0.0.0.0 --port #{port}
}

// Build every version in versions.json into site-dist/, as CI does.
//
// Each version is built from the lask checkout's tag v<version>, or from
// its development branch until that tag exists, so the checkout needs
// both fetched.
//
// @param lask_src  The lask checkout: ../lask unless LASK_SRC names another.
// @param tools_src The lask-module-tools checkout, for the module reference:
//                  ../lask-module-tools unless TOOLS_SRC names another.
build(--lask_src: String = default_lask_src(), --tools_src: String = default_tools_src()) = do {
  ensure_installed()
  module_help(tools_src)
  $[site(absolute(lask_src), [])] npm run build
}

// Build every version, then serve them as GitHub Pages would, until you
// stop it.
//
// @param port      The port, on the host and in the container alike.
// @param lask_src  The lask checkout: ../lask unless LASK_SRC names another.
// @param tools_src The lask-module-tools checkout, for the module reference:
//                  ../lask-module-tools unless TOOLS_SRC names another.
// @example lask run preview
preview(--port: Number = 4173, --lask_src: String = default_lask_src(), --tools_src: String = default_tools_src()) = do {
  build(lask_src = lask_src, tools_src = tools_src)
  log("open http://localhost:#{port}")
  $[site(absolute(lask_src), ["127.0.0.1:#{port}:#{port}"])] npm run preview -- #{port}
}

// ---------------------------------------------------------------------
// Releasing a version
//
// What README.md describes under "When a version is released and the
// next one starts", run on the host with git and an authenticated gh,
// after lask vX.Y.Z is published.
// ---------------------------------------------------------------------

lask_repo = "lask-task-runner/lask"

type Asset = Record<name: String, digest: String | Null>

// The sha256 GitHub records for one asset of a lask release.
internal asset_sha256(tag: String, name: String): String = do {
  out = $[#local] gh release view #{tag} --repo #{lask_repo} --json assets --jq '{assets: [.assets[] | {name, digest}]}'
  listed: Record<assets: Array<Asset>> = cast(from_json(out))
  found = find(listed.assets, \(a: Asset) -> a.name == name)
  case (found) {
    Null -> fail(error(1, "#{tag} has no #{name}"))
    else -> do {
      d = found.digest
      case (d) {
        Null -> fail(error(1, "GitHub records no digest for #{name}"))
        else -> replace(d, "sha256:", "")
      }
    }
  }
}

// Rewrite each line of a file that matches pattern.
internal rewrite_lines(file: String, pattern: String, replacement: String) = do {
  text = read_file(file, #local)
  updated = map(lines(text), \(l: String) -> case {
    regex_test(l, pattern) -> regex_replace(l, pattern, replacement)
    else -> l
  })
  write_file(file, concat(join(updated, "\n"), "\n"), #local)
}

internal json_string(s: String): String = to_json(s)

// versions.json, in the layout it is written in by hand.
internal versions_json(entries: Array<Map<String>>): String = do {
  keys_in_order = ["version", "site", "lask", "tools"]
  entry = \(v: Map<String>) -> do {
    fields = map(filter(keys_in_order, \(k: String) -> has_key(v, k)), \(k: String) -> "      #{json_string(k)}: #{json_string(v[k])}")
    "    {\n#{join(fields, ",\n")}\n    }"
  }
  "{\n  \"versions\": [\n#{join(map(entries, entry), ",\n")}\n  ]\n}\n"
}

// Name a released version on the pages, freeze them for it, and start
// the next version.
//
// On main: puts the version in Getting started and Running in CI (with
// the linux-amd64 archive's sha256), commits and tags the result
// docs-X.Y.Z, then points that version at the tag in versions.json and
// adds the next one on top, using dev and the same tools ref. Pushes
// main and the tag. Asks for confirmation (lask.json).
//
// @param version  The version lask just released, without the leading v.
// @param next     The version main describes from now on.
// @example lask run release 0.9.0 0.10.0
release(version: String, next: String) = do {
  tag = "v#{version}"
  $[#local] git switch -q main && git pull -q --ff-only origin main
  $[#local] git diff --quiet && git diff --cached --quiet || { echo 'the working tree has uncommitted changes' >&2; exit 1; }
  listed: Record<versions: Array<Map<String>>> = cast(from_json(read_file("versions.json", #local)))
  current = first(listed.versions)
  if (current["version"] != version || current["site"] != "HEAD") {
    return fail(error(1, "versions.json does not start with #{version} at HEAD"))
  }
  existing = $[#local] git ls-remote --tags origin refs/tags/docs-#{version}
  if (trim(existing) != "") {
    return fail(error(1, "docs-#{version} already exists"))
  }
  sha = asset_sha256(tag, "lask-#{tag}-linux-amd64.tar.gz")

  rewrite_lines("docs/guide/getting-started.md", "^lask [0-9]+\\.[0-9]+\\.[0-9]+$", "lask #{version}")
  rewrite_lines("docs/guide/ci.md", "LASK_VERSION: v[0-9.]+$", "LASK_VERSION: #{tag}")
  rewrite_lines("docs/guide/ci.md", "LASK_SHA256: [0-9a-f]+$", "LASK_SHA256: #{sha}")
  rewrite_lines("docs/guide/ci.md", "for `v[0-9.]+` on `linux-amd64`", "for `#{tag}` on `linux-amd64`")
  // Nothing to commit when the pages already name it.
  $[#local] git diff --quiet -- docs/guide || git commit -q -m "Name #{version} as the release in Getting started and Running in CI" -- docs/guide/getting-started.md docs/guide/ci.md
  $[#local] git tag docs-#{version}

  frozen = map(listed.versions, \(v: Map<String>) -> case {
    v["version"] == version -> set(v, "site", "docs-#{version}")
    else -> v
  })
  started = merge(current, {"version": next, "site": "HEAD", "lask": "dev"})
  write_file("versions.json", versions_json(concat_array([started], frozen)), #local)
  $[#local] git commit -q -m "Freeze #{version} at docs-#{version}, and add #{next} (unreleased)" -- versions.json
  $[#local] git push -q origin main docs-#{version}
}
